# Local Windows API + Docker Web/AI pilot. Never commit .env.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__CreatorFlow=Server=localhost;Database=CreatorFlow_QC;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;
CREATORFLOW_STORAGE_ROOT=./artifacts
CREATORFLOW_AI_BASE_URL=http://localhost:8001
CREATORFLOW_AI_API_KEY=
CREATORFLOW_LLM_BASE_URL=https://api.openai.com/v1
CREATORFLOW_LLM_API_KEY=
CREATORFLOW_LLM_MODEL=
CREATORFLOW_LLM_TIMEOUT_SECONDS=60
CREATORFLOW_LLM_MAX_OUTPUT_TOKENS=3000

# Local-only API bootstrap key (at least 32 characters). Web key must match it.
Authentication__ApiKey=
CreatorFlowApi__BaseUrl=http://host.docker.internal:7001
CreatorFlowApi__ApiKey=

# Local-only Keycloak OIDC provider (Development only). Never commit .env.
# Add 127.0.0.1 creatorflow-id.test to the Windows hosts file (see IDENTITY_SETUP.md).
KEYCLOAK_ADMIN_USERNAME=cf-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
KEYCLOAK_PUBLIC_URL=http://creatorflow-id.test:8180

# Keep this exact issuer identical in Web and API. Client secret is generated by Keycloak.
Authentication__Oidc__Authority=http://creatorflow-id.test:8180/realms/creatorflow
Authentication__Oidc__ClientId=creatorflow-web
Authentication__Oidc__ClientSecret=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
Authentication__Oidc__ApiScope=creatorflow-api
Authentication__Oidc__Audience=creatorflow-api
Authentication__OwnerBootstrapToken=REPLACE_WITH_A_RANDOM_ONE_TIME_SECRET

# Native Windows video renderer. FFmpeg is the current default; After Effects is not required.
# Keep the same storage root for the API and worker.
VideoRendering__Engine=ffmpeg
VideoRendering__StorageRoot=C:/CreatorFlowData/Video
VideoRendering__FFmpegExe=C:/Tools/ffmpeg/bin/ffmpeg.exe
VideoRendering__FFprobeExe=C:/Tools/ffmpeg/bin/ffprobe.exe
VideoRendering__FontFile=C:/Windows/Fonts/arial.ttf
# Optional future provider settings (not required for FFmpeg):
# VideoRendering__AfterEffectsExe=
# VideoRendering__AerenderExe=
