@@ -0,0 +1,23 @@
+# Z240 deployment (API as a Scheduled Task)
+
+The API runs as the Scheduled Task `CreatorFlow-Api`, not as a child of the GitHub runner, so it keeps
+running after a workflow job ends. Each deployment publishes to `E:\CreatorFlowDeploy\releases\<time>-<sha>`,
+repoints the junction `E:\CreatorFlowDeploy\current`, restarts the task and checks `/health`. If the new
+release is unhealthy the previous release is restored and the workflow fails.
+
+## One-time setup (elevated PowerShell on the Z240)
+1. Decide the Windows account that runs the API. Use the account that previously ran it, so DPAPI-protected
+   Data Protection keys still decrypt tenant connector credentials.
+2. Add `CREATORFLOW_DATA_PROTECTION_KEYS_PATH=<fixed folder>` to `E:\Projects\CreatorFlow-AI\.env` (readable only by that
+   account) before the first deployment.
+3. Run `scripts\deploy\Register-CreatorFlowApiTask.ps1 -UserName <account>`.
+4. The runner account must be able to start/stop the task (administrator is sufficient).
+5. First deployment from a manually started API: run
+   `scripts\deploy\Deploy-CreatorFlowApi.ps1 -AdoptLegacyProcess` once from a normal PowerShell prompt and watch it.
+6. In GitHub: Settings -> Environments -> `z240-dev` -> add required reviewers.
+
+## Operations
+- Deploy: Actions -> "Deploy to Z240" -> Run workflow (approval required).
+- Logs: `E:\CreatorFlowDeploy\logs\api-<date>.log`.
+- Manual rollback: stop the task, repoint `current` to an earlier folder in `releases`, start the task.
+- Not covered: database migrations are not applied by this workflow; run the SQL QC/migration process first.
diff --git a/scripts/deploy/Deploy-CreatorFlowApi.ps1 b/scripts/deploy/Deploy-CreatorFlowApi.ps1
new file mode 100644
index 0000000..2624cdc
--- /dev/null
+++ b/scripts/deploy/Deploy-CreatorFlowApi.ps1
@@ -0,0 +1,138 @@
+<#
+.SYNOPSIS
+  Publishes the API into a new release folder, switches <DeployRoot>\current to it, restarts the
+  Scheduled Task and verifies /health. If the new release is not healthy it switches back to the
+  previous release and fails the run, so a bad build does not leave the service down.
+#>
+[CmdletBinding()]
+param(
+    [string]$ProjectPath = 'src\CreatorFlow.Api\CreatorFlow.Api.csproj',
+    [string]$DeployRoot = 'E:\CreatorFlowDeploy',
+    [string]$EnvFile = 'E:\Projects\CreatorFlow-AI\.env',
+    [string]$TaskName = 'CreatorFlow-Api',
+    [int]$Port = 7001,
+    [string]$Revision = '',
+    [int]$KeepReleases = 5,
+    [int]$HealthTimeoutSeconds = 90,
+    # First migration from a manually started API: also stop a CreatorFlow.Api process that is not
+    # under DeployRoot. Without this switch the script refuses to touch foreign listeners.
+    [switch]$AdoptLegacyProcess
+)
+
+$ErrorActionPreference = 'Stop'
+$releasesDir = Join-Path $DeployRoot 'releases'
+$currentLink = Join-Path $DeployRoot 'current'
+$binDir = Join-Path $DeployRoot 'bin'
+
+function Get-PortOwners {
+    $connections = @(Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue)
+    return @($connections | Select-Object -ExpandProperty OwningProcess -Unique)
+}
+
+function Stop-Api {
+    Stop-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+    $deadline = (Get-Date).AddSeconds(30)
+    while ((Get-Date) -lt $deadline) {
+        $owners = Get-PortOwners
+        if ($owners.Count -eq 0) { return }
+        foreach ($processId in $owners) {
+            $info = Get-CimInstance Win32_Process -Filter "ProcessId = $processId" -ErrorAction SilentlyContinue
+            $commandLine = if ($info) { [string]$info.CommandLine } else { '' }
+            $ours = $commandLine -like "*$DeployRoot*"
+            $legacy = $commandLine -match 'CreatorFlow\.Api'
+            if ($ours -or ($AdoptLegacyProcess -and $legacy)) {
+                Stop-Process -Id $processId -Force -ErrorAction SilentlyContinue
+            } else {
+                throw "Port $Port is held by process $processId ($commandLine), which is not this service. Refusing to stop it (use -AdoptLegacyProcess only for an old CreatorFlow.Api process)."
+            }
+        }
+        Start-Sleep -Seconds 1
+    }
+    throw "Port $Port is still in use after stopping the service."
+}
+
+function Get-CurrentRelease {
+    if (-not (Test-Path -LiteralPath $currentLink)) { return $null }
+    $target = (Get-Item -LiteralPath $currentLink -Force).Target
+    if ($target -is [array]) { $target = $target[0] }
+    return $target
+}
+
+function Set-CurrentRelease([string]$target) {
+    if (Test-Path -LiteralPath $currentLink) { [System.IO.Directory]::Delete($currentLink) }
+    New-Item -ItemType Junction -Path $currentLink -Target $target | Out-Null
+}
+
+function Wait-Healthy {
+    $deadline = (Get-Date).AddSeconds($HealthTimeoutSeconds)
+    while ((Get-Date) -lt $deadline) {
+        Start-Sleep -Seconds 2
+        try {
+            $response = Invoke-WebRequest -Uri "http://127.0.0.1:$Port/health" -UseBasicParsing -TimeoutSec 3
+            if ($response.StatusCode -eq 200) { return $true }
+        } catch { }
+    }
+    return $false
+}
+
+function Show-LogTail {
+    $log = Join-Path (Join-Path $DeployRoot 'logs') ("api-{0}.log" -f (Get-Date -Format 'yyyyMMdd'))
+    if (Test-Path -LiteralPath $log) { Get-Content -LiteralPath $log -Tail 60 } else { Write-Host 'No API log found.' }
+}
+
+# ---- Preflight -------------------------------------------------------------------------------
+if (-not (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue)) {
+    throw "Scheduled task '$TaskName' is not registered. Run scripts\deploy\Register-CreatorFlowApiTask.ps1 first."
+}
+if (-not (Test-Path -LiteralPath $EnvFile)) {
+    throw "Required .env file was not found at $EnvFile; refusing to deploy."
+}
+if (-not (Select-String -LiteralPath $EnvFile -Pattern '^\s*(export\s+)?CREATORFLOW_DATA_PROTECTION_KEYS_PATH\s*=' -Quiet)) {
+    Write-Warning 'CREATORFLOW_DATA_PROTECTION_KEYS_PATH is not set in the .env file. Keys fall back to the service account profile; tenant credentials become unreadable if the account changes.'
+}
+
+# ---- Publish ---------------------------------------------------------------------------------
+$suffix = if ($Revision) { $Revision.Substring(0, [Math]::Min(8, $Revision.Length)) } else { 'manual' }
+$releaseName = '{0}-{1}' -f (Get-Date -Format 'yyyyMMdd-HHmmss'), $suffix
+$releaseDir = Join-Path $releasesDir $releaseName
+New-Item -ItemType Directory -Force -Path $releasesDir, $binDir | Out-Null
+
+& dotnet publish $ProjectPath -c Release -o $releaseDir --no-self-contained
+if ($LASTEXITCODE -ne 0) { throw 'dotnet publish failed; the running service was not touched.' }
+if (-not (Test-Path -LiteralPath (Join-Path $releaseDir 'CreatorFlow.Api.dll'))) {
+    throw 'Published output does not contain CreatorFlow.Api.dll; the running service was not touched.'
+}
+Set-Content -LiteralPath (Join-Path $releaseDir 'release.txt') -Value $Revision -Encoding utf8
+Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'Run-CreatorFlowApi.ps1') -Destination $binDir -Force
+
+# ---- Switch with rollback --------------------------------------------------------------------
+$previous = Get-CurrentRelease
+Write-Host "Previous release: $previous"
+Write-Host "New release:      $releaseDir"
+
+Stop-Api
+Set-CurrentRelease $releaseDir
+Start-ScheduledTask -TaskName $TaskName
+
+if (Wait-Healthy) {
+    Write-Host "API is healthy on port $Port (release $releaseName)."
+} else {
+    Show-LogTail
+    if ($previous -and (Test-Path -LiteralPath $previous)) {
+        Write-Warning "New release is not healthy; rolling back to $previous."
+        Stop-Api
+        Set-CurrentRelease $previous
+        Start-ScheduledTask -TaskName $TaskName
+        $restored = Wait-Healthy
+        throw ("Deployment of $releaseName failed health check. Rollback " + $(if ($restored) { 'succeeded.' } else { 'ALSO FAILED; the service is down.' }))
+    }
+    throw "Deployment of $releaseName failed health check and there is no previous release to roll back to."
+}
+
+# ---- Retention -------------------------------------------------------------------------------
+$keep = @($releaseDir, $previous) | Where-Object { $_ }
+Get-ChildItem -LiteralPath $releasesDir -Directory |
+    Sort-Object Name -Descending |
+    Select-Object -Skip $KeepReleases |
+    Where-Object { $keep -notcontains $_.FullName } |
+    ForEach-Object { Remove-Item -LiteralPath $_.FullName -Recurse -Force -ErrorAction SilentlyContinue }
diff --git a/scripts/deploy/Register-CreatorFlowApiTask.ps1 b/scripts/deploy/Register-CreatorFlowApiTask.ps1
new file mode 100644
index 0000000..50d8169
--- /dev/null
+++ b/scripts/deploy/Register-CreatorFlowApiTask.ps1
@@ -0,0 +1,38 @@
+<#
+.SYNOPSIS
+  One-time setup (run from an elevated PowerShell on the Z240): registers the Scheduled Task that
+  runs the API. Use the SAME Windows account that previously ran the API so that the DPAPI-protected
+  Data Protection keys (tenant connector credentials) can still be decrypted.
+#>
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)][string]$UserName,
+    [string]$TaskName = 'CreatorFlow-Api',
+    [string]$DeployRoot = 'E:\CreatorFlowDeploy',
+    [string]$EnvFile = 'E:\Projects\CreatorFlow-AI\.env',
+    [int]$Port = 7001
+)
+
+$ErrorActionPreference = 'Stop'
+$credential = Get-Credential -UserName $UserName -Message "Password for the account that runs CreatorFlow.Api"
+$plainPassword = $credential.GetNetworkCredential().Password
+
+$binDir = Join-Path $DeployRoot 'bin'
+New-Item -ItemType Directory -Force -Path $binDir | Out-Null
+Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'Run-CreatorFlowApi.ps1') -Destination $binDir -Force
+$launcher = Join-Path $binDir 'Run-CreatorFlowApi.ps1'
+
+$argument = '-NoProfile -ExecutionPolicy Bypass -File "{0}" -DeployRoot "{1}" -EnvFile "{2}" -Port {3}' -f $launcher, $DeployRoot, $EnvFile, $Port
+$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument $argument
+$trigger = New-ScheduledTaskTrigger -AtStartup
+$settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
+    -MultipleInstances IgnoreNew -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 1) `
+    -ExecutionTimeLimit (New-TimeSpan -Seconds 0)
+
+Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $trigger -Settings $settings `
+    -User $credential.UserName -Password $plainPassword -RunLevel Limited -Force | Out-Null
+$plainPassword = $null
+
+Write-Host "Registered task '$TaskName' (runs as $($credential.UserName))."
+Write-Host "The account that runs the GitHub runner must be allowed to start/stop this task (administrator is sufficient)."
+Write-Host "Set CREATORFLOW_DATA_PROTECTION_KEYS_PATH in $EnvFile to a fixed folder readable only by $($credential.UserName)."
diff --git a/scripts/deploy/Run-CreatorFlowApi.ps1 b/scripts/deploy/Run-CreatorFlowApi.ps1
new file mode 100644
index 0000000..1cc0341
--- /dev/null
+++ b/scripts/deploy/Run-CreatorFlowApi.ps1
@@ -0,0 +1,39 @@
+<#
+.SYNOPSIS
+  Launcher executed by the "CreatorFlow-Api" Scheduled Task. Runs the published API from
+  <DeployRoot>\current and appends its console output to a daily log file.
+  The task (not the GitHub runner) owns the process, so it survives the end of a workflow job.
+#>
+[CmdletBinding()]
+param(
+    [string]$DeployRoot = 'E:\CreatorFlowDeploy',
+    [string]$EnvFile = 'E:\Projects\CreatorFlow-AI\.env',
+    [int]$Port = 7001
+)
+
+$ErrorActionPreference = 'Stop'
+$app = Join-Path $DeployRoot 'current'
+$dll = Join-Path $app 'CreatorFlow.Api.dll'
+if (-not (Test-Path -LiteralPath $dll)) { throw "Published API not found: $dll" }
+
+$logDir = Join-Path $DeployRoot 'logs'
+New-Item -ItemType Directory -Force -Path $logDir | Out-Null
+$log = Join-Path $logDir ("api-{0}.log" -f (Get-Date -Format 'yyyyMMdd'))
+
+# The .env file is opt-in and only supplies values that are not already set in the process.
+$env:CREATORFLOW_LOAD_DOTENV = 'true'
+$env:CREATORFLOW_DOTENV_PATH = $EnvFile
+
+# Bind on all interfaces by default so the Web container can reach host.docker.internal:<port>,
+# unless ASPNETCORE_URLS is already provided by the process or by the .env file.
+if (-not $env:ASPNETCORE_URLS) {
+    $inFile = (Test-Path -LiteralPath $EnvFile) -and
+        (Select-String -LiteralPath $EnvFile -Pattern '^\s*(export\s+)?ASPNETCORE_URLS\s*=' -Quiet)
+    if (-not $inFile) { $env:ASPNETCORE_URLS = "http://0.0.0.0:$Port" }
+}
+
+Set-Location -LiteralPath $app
+"[{0}] Starting CreatorFlow.Api from {1}" -f (Get-Date -Format 's'), $app | Out-File -FilePath $log -Append -Encoding utf8
+& dotnet $dll 2>&1 | Out-File -FilePath $log -Append -Encoding utf8
+"[{0}] CreatorFlow.Api exited with code {1}" -f (Get-Date -Format 's'), $LASTEXITCODE | Out-File -FilePath $log -Append -Encoding utf8
+exit $LASTEXITCODE
