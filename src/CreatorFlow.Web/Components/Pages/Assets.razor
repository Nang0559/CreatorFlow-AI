@page "/assets"
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject CreatorFlow.Web.Services.CreatorFlowApiClient Api

<PageTitle>Thư viện video · CreatorFlow</PageTitle>
<header class="page-header">
    <div><p class="eyebrow">THƯ VIỆN NỘI DUNG</p><h1>Video của bạn</h1>
        <p class="muted">Tải video nguồn lên, chọn phong cách dựng và nhận MP4 hoàn chỉnh ngay trong CreatorFlow.</p></div>
    <button class="secondary" @onclick="LoadAsync" disabled="@busy">Làm mới</button>
</header>

@if (!Api.IsConfigured)
{
    <section class="notice"><strong>Chưa kết nối máy chủ</strong><p>Hãy cấu hình kết nối CreatorFlow API trên máy chủ.</p></section>
}
@if (!string.IsNullOrWhiteSpace(message))
{
    <section class="notice"><strong>@message</strong></section>
}

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">BƯỚC 1</p><h2>Tải video nguồn</h2></div><span class="status">Tối đa 500 MB</span></div>
    <label class="field-label">Ghi chú quyền sử dụng (không bắt buộc)
        <input @bind="rightsNote" placeholder="Ví dụ: Video tự quay / đã được cấp phép sử dụng" />
    </label>
    <label class="rights-confirm"><InputCheckbox @bind-Value="confirmRights" /> Tôi xác nhận mình có quyền sử dụng video này để biên tập và tạo nội dung mới.</label>
    <div class="upload-row">
        <InputFile OnChange="UploadAsync" accept=".mp4,.mov,.m4v,video/mp4,video/quicktime" disabled="@(!Api.IsConfigured || busy || !confirmRights)" />
        <span class="muted">Định dạng MP4, MOV, M4V</span>
    </div>
    @if (busy) { <p class="muted">Đang xử lý, vui lòng giữ trang này mở…</p> }
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">BƯỚC 2</p><h2>Tạo video hoàn chỉnh</h2></div></div>
    @if (assets.Count == 0) { <p class="muted">Chưa có video nguồn. Hãy tải video lên trước.</p> }
    else
    {
        <div class="render-form">
            <label>Video nguồn
                <select @bind="selectedAsset">
                    @foreach (var asset in assets)
                    {
                        <option value="@asset.Id">@asset.FileName · @FormatSize(asset.SizeBytes)</option>
                    }
                </select>
            </label>
            <label>Tiêu đề hiển thị<input @bind="title" maxlength="180" /></label>
            <label>Câu mở đầu<input @bind="hook" maxlength="500" /></label>
            <label>Lời kêu gọi hành động<input @bind="cta" maxlength="300" /></label>
            <div class="style-options">
                <strong>Chọn 2 hoặc 3 phong cách để so sánh</strong>
                <label><InputCheckbox @bind-Value="useNatural" /> Tự nhiên</label>
                <label><InputCheckbox @bind-Value="useStory" /> Kể chuyện</label>
                <label><InputCheckbox @bind-Value="useReview" /> Đánh giá sản phẩm</label>
            </div>
        </div>
        <button class="primary" disabled="@(busy || string.IsNullOrWhiteSpace(selectedAsset) || string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(hook) || SelectedStyleCount < 2)" @onclick="CreateJobAsync">Dựng các phương án MP4</button>
    }
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">BƯỚC 3</p><h2>Video đã xử lý</h2></div><span class="status">@jobs.Count video</span></div>
    @if (jobs.Count == 0) { <p class="muted">Các video đã dựng sẽ xuất hiện tại đây.</p> }
    @foreach (var job in jobs)
    {
        <article class="render-job">
            <div class="panel-heading">
                <div><h3>@job.Title</h3><p class="muted">@job.StyleKey · @job.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div>
                <span class="status">@VietnameseStatus(job.Status)</span>
            </div>
            <div class="progress-track"><div class="progress-value" style="width:@(job.ProgressPercent)%"></div></div>
            <p class="muted">@job.ProgressPercent% hoàn thành</p>
            @if (job.Status == "Completed")
            {
                <video class="video-preview" controls playsinline preload="metadata" src="@($"/media/video/{job.Id}")"></video>
                <div class="render-meta"><span>@(job.Width ?? 0) × @(job.Height ?? 0)</span><span>@(job.DurationSeconds?.ToString("0.0") ?? "—") giây</span></div>
                <a class="primary download-link" href="@($"/media/video/{job.Id}?download=1")">Tải video MP4</a>
            }
            else if (job.Status == "Failed")
            {
                <p class="error-text">Không thể dựng video. Hãy kiểm tra After Effects, FFmpeg và video nguồn trên máy dựng.</p>
            }
        </article>
    }
</section>

<style>
.field-label,.render-form label{display:flex;flex-direction:column;gap:.45rem;font-weight:600}
.field-label input,.render-form input,.render-form select{width:100%;padding:.75rem;border:1px solid var(--border,#ddd);border-radius:10px;background:var(--surface,#fff);color:inherit}
.rights-confirm{display:flex;gap:.6rem;align-items:flex-start;margin-top:1rem;font-weight:500}.upload-row{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin-top:1rem}
.style-options{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin:1rem 0}.style-options label{display:flex;gap:.4rem;align-items:center}.render-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin:1rem 0}
.render-job{padding:1rem 0;border-top:1px solid var(--border,#ddd)}
.progress-track{height:8px;border-radius:99px;background:var(--surface-alt,#eee);overflow:hidden}
.progress-value{height:100%;background:#8b5cf6;transition:width .25s}
.video-preview{display:block;width:min(100%,420px);max-height:720px;margin:1rem auto;border-radius:14px;background:#111}
.render-meta{display:flex;gap:1rem;color:var(--muted);margin:.5rem 0 1rem}
.download-link{display:inline-block;text-decoration:none;padding:.7rem 1rem;border-radius:10px}
.error-text{color:#b42318}
@@media(max-width:600px){.video-preview{width:100%}}
</style>

@code {
    private List<CreatorFlow.Web.Services.VideoAssetItem> assets = [];
    private List<CreatorFlow.Web.Services.VideoRenderJobItem> jobs = [];
    private string selectedAsset = "";
    private string rightsNote = "";
    private bool confirmRights;
    private string title = "Video mới";
    private string hook = "Điều bạn cần biết trước khi lựa chọn";
    private string cta = "Xem thêm thông tin ở giỏ hàng";
    private bool useNatural = true;
    private bool useStory = true;
    private bool useReview;
    private int SelectedStyleCount => (useNatural ? 1 : 0) + (useStory ? 1 : 0) + (useReview ? 1 : 0);
    private string message = "";
    private bool busy;
    private readonly CancellationTokenSource refreshCts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(refreshCts.Token))
                await InvokeAsync(LoadAsync);
        }
        catch (OperationCanceledException) { }
    }

    public ValueTask DisposeAsync()
    {
        refreshCts.Cancel();
        refreshCts.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task LoadAsync()
    {
        if (!Api.IsConfigured) return;
        try
        {
            assets = await Api.GetAsync<List<CreatorFlow.Web.Services.VideoAssetItem>>("/api/v1/video/assets") ?? [];
            jobs = await Api.GetAsync<List<CreatorFlow.Web.Services.VideoRenderJobItem>>("/api/v1/video/render-jobs") ?? [];
            if (string.IsNullOrWhiteSpace(selectedAsset) && assets.Count > 0) selectedAsset = assets[0].Id.ToString();
            message = "";
        }
        catch { message = "Không thể tải thư viện video. Hãy kiểm tra kết nối và quyền truy cập."; }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        try
        {
            busy = true; message = "";
            await using var stream = args.File.OpenReadStream(524_288_000);
            var result = await Api.UploadVideoAsync(stream,args.File.Name,rightsNote,confirmRights);
            if (result is null) throw new InvalidOperationException();
            message = "Đã thêm video nguồn vào thư viện.";
            await LoadAsync();
            selectedAsset = result.Id.ToString();
        }
        catch { message = "Không thể tải video lên. Hãy kiểm tra định dạng MP4/MOV/M4V và giới hạn 500 MB."; }
        finally { busy = false; }
    }

    private async Task CreateJobAsync()
    {
        if (!Guid.TryParse(selectedAsset,out var assetId)) return;
        try
        {
            busy = true; message = "";
            var styles = new List<string>();
            if (useNatural) styles.Add("Tự nhiên");
            if (useStory) styles.Add("Kể chuyện");
            if (useReview) styles.Add("Đánh giá sản phẩm");
            if (styles.Count is < 2 or > 3) { message = "Hãy chọn 2 hoặc 3 phong cách."; return; }
            foreach (var style in styles)
                await Api.PostAsync<object,object>("/api/v1/video/render-jobs",new { assetId,title,hook,callToAction=cta,styleKey=style });
            message = $"Đã đưa {styles.Count} phương án vào hàng đợi dựng.";
            await LoadAsync();
        }
        catch { message = "Không thể tạo tác vụ dựng. Hãy kiểm tra video nguồn và kết nối máy chủ."; }
        finally { busy = false; }
    }

    private static string VietnameseStatus(string status) => status switch
    {
        "Queued" => "Chờ dựng",
        "Rendering" => "Đang dựng",
        "Encoding" => "Đang xuất MP4",
        "Completed" => "Đã hoàn tất",
        "Failed" => "Cần xử lý lỗi",
        "Cancelled" => "Đã hủy",
        _ => "Chưa xác định"
    };
    private static string FormatSize(long bytes) => bytes >= 1_000_000_000 ? $"{bytes/1_000_000_000d:0.0} GB" : $"{bytes/1_000_000d:0.0} MB";
}
