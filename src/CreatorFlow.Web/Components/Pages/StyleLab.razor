@page "/style-lab"
@inject CreatorFlow.Web.Services.CreatorFlowApiClient Api
@inject IJSRuntime JS

<PageTitle>Phòng sáng tạo · CreatorFlow</PageTitle>
<header class="page-header">
    <div><p class="eyebrow">THỬ NGHIỆM SÁNG TẠO</p><h1>Phòng sáng tạo</h1>
        <p class="muted">Tạo 2–3 cách thể hiện khác nhau cho cùng một ý tưởng, đo lường sau khi đăng và chọn phương án thắng.</p></div>
    <button class="primary" @onclick="LoadAsync">Làm mới</button>
</header>
@if (!Api.IsConfigured) { <section class="notice"><strong>Chưa kết nối API</strong><p>Cần cấu hình CreatorFlowApi ở server Web.</p></section> }
@if (!string.IsNullOrWhiteSpace(error)) { <section class="notice"><strong>Thông báo</strong><p>@error</p></section> }

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">THỬ NGHIỆM MỚI</p><h2>Tạo thử nghiệm phong cách</h2></div></div>
    <div class="trend-form">
        <label>Tên thử nghiệm<input @bind="name" /></label>
        <label>Giả thuyết<input @bind="hypothesis" /></label>
        <label>Chủ đề nội dung<input @bind="topic" placeholder="Ví dụ: gia dụng, làm đẹp, chăm sóc da" /></label>
        <label>Số phương án<select @bind="variantCount"><option value="2">2 phương án</option><option value="3">3 phương án</option></select></label>
    </div>
    @for (var i = 0; i < variantCount; i++)
    {
        var index = i;
        <div class="variant-editor">
            <h3>Phương án @(index + 1)</h3>
            <div class="trend-form">
                <label>Tên<input @bind="variants[index].Name" /></label>
                <label>Hook / mở đầu<input @bind="variants[index].Hook" /></label>
                <label>Phong cách nói<input @bind="variants[index].SpeakingStyle" /></label>
                <label>Nhịp dựng<input @bind="variants[index].EditPacing" /></label>
                <label>Cách dùng âm thanh<input @bind="variants[index].AudioApproach" /></label>
                <label>Kịch bản<textarea @bind="variants[index].Script" rows="3"></textarea></label>
            </div>
        </div>
    }
    <button class="primary" disabled="@(!Api.IsConfigured || busy)" @onclick="CreateAsync">Tạo thử nghiệm</button>
    @if (aiGenerated) { <p class="muted">Các phương án được tạo bằng LLM. Kiểm tra nội dung, tính chính xác của thông tin và quyền sử dụng trước khi lưu.</p> }
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">LỊCH SỬ THỬ NGHIỆM</p><h2>Các thử nghiệm</h2></div><span class="status">@experiments.Count thử nghiệm</span></div>
    @if (experiments.Count == 0) { <p class="muted">Chưa có thử nghiệm. Mỗi thử nghiệm cần 2 hoặc 3 phương án được viết độc lập.</p> }
    @foreach (var experiment in experiments)
    {
        <article class="experiment-item">
            <div class="panel-heading"><div><h3>@experiment.Name</h3><p class="muted">@experiment.Hypothesis</p><p class="muted">Chủ đề: @(string.IsNullOrWhiteSpace(experiment.Topic) ? "Chưa phân loại" : experiment.Topic)</p></div><span class="status">@StatusLabel(experiment.Status)</span></div>
            @if (experiment.Status == "Draft") { <button class="secondary" disabled="@(busy || experiment.Variants.Any(x => x.Status != "Ready"))" @onclick="() => StartAsync(experiment.Id)">Bắt đầu thử nghiệm</button> }
            <div class="variant-grid">
                @foreach (var variant in experiment.Variants)
                {
                    <div class="variant-card">
                        <strong>@variant.Name</strong><span class="status">@StatusLabel(variant.Status)</span>
                        <p><b>Câu mở đầu:</b> @variant.Hook</p><p><b>Phong cách nói:</b> @variant.SpeakingStyle</p><p><b>Nhịp dựng:</b> @variant.EditPacing</p><p><b>Âm thanh:</b> @variant.AudioApproach</p>
                        <div class="variant-stats"><span>@variant.Views.ToString("N0") lượt xem</span><span>@(variant.EngagementRate?.ToString("0.00") ?? "—")% tương tác</span><span>@variant.FollowsGained lượt theo dõi</span><span>@variant.Orders đơn hàng</span></div>
                        <button class="secondary" disabled="@busy" @onclick="() => DownloadEditingPackageAsync(experiment.Id, variant.Id)">Tải gói hướng dẫn dựng (tùy chọn)</button>

                        @if (variant.Status == "Draft") { <button class="secondary" disabled="@busy" @onclick="() => MarkReadyAsync(experiment.Id, variant.Id)">Đánh dấu đã chuẩn bị</button> }
                        @if (variant.Status == "Ready") { <button class="secondary" disabled="@busy" @onclick="() => MarkPublishedAsync(experiment.Id, variant.Id)">Đã đăng video này</button> }
                        @if (variant.Status == "Published")
                        {
                            <div class="metrics-editor">
                                <label>Views<input type="number" min="0" @bind="metricInputs[variant.Id].Views" /></label>
                                <label>Likes<input type="number" min="0" @bind="metricInputs[variant.Id].Likes" /></label>
                                <label>Comments<input type="number" min="0" @bind="metricInputs[variant.Id].Comments" /></label>
                                <label>Shares<input type="number" min="0" @bind="metricInputs[variant.Id].Shares" /></label>
                                <label>Saves<input type="number" min="0" @bind="metricInputs[variant.Id].Saves" /></label>
                                <label>Follows<input type="number" min="0" @bind="metricInputs[variant.Id].FollowsGained" /></label>
                                <label>Lượt nhấp sản phẩm<input type="number" min="0" @bind="metricInputs[variant.Id].ProductClicks" /></label>
                                <label>Orders<input type="number" min="0" @bind="metricInputs[variant.Id].Orders" /></label>
                                <label>Thời gian xem trung bình (giây)<input type="number" min="0" step="0.1" @bind="metricInputs[variant.Id].AverageWatchSeconds" /></label>
                                <label>Thời lượng video (giây)<input type="number" min="0" step="0.1" @bind="metricInputs[variant.Id].VideoDurationSeconds" /></label>
                            </div>
                            <button class="secondary" disabled="@busy" @onclick="() => MeasureAsync(experiment.Id, variant.Id)">Lưu số liệu</button>
                        }
                    </div>
                }
            </div>
            @if (experiment.Status == "Running" && experiment.Variants.All(x => x.Status == "Measured"))
            {
                <div class="learn-row">
                    <label>Chọn phương án hiệu quả nhất
                        <select @bind="winnerSelections[experiment.Id]">
                            @foreach (var v in experiment.Variants) { <option value="@v.Id">@v.Name</option> }
                        </select>
                    </label>
                    <button class="primary" disabled="@busy" @onclick="() => EvaluateAsync(experiment.Id)">Đánh giá kết quả</button>
                </div>
            }
            @if (experiment.WinningVariantId.HasValue) { <p class="winner">Phương án hiệu quả nhất: @experiment.Variants.FirstOrDefault(x => x.Id == experiment.WinningVariantId)?.Name</p> }
        </article>
    }
</section>

@code {
    private List<CreatorFlow.Web.Services.StyleExperimentItem> experiments = [];
    private List<VariantInput> variants = [new() { Name = "Tự nhiên", Hook = "Bạn có từng gặp tình huống này?", SpeakingStyle = "Gần gũi, trò chuyện", EditPacing = "Nhịp vừa, cắt theo ý", AudioApproach = "Nhạc nền nhẹ" },
        new() { Name = "Storytelling", Hook = "Tôi đã bất ngờ khi thử...", SpeakingStyle = "Kể chuyện có cao trào", EditPacing = "Mở chậm, tăng nhịp ở điểm chính", AudioApproach = "Âm thanh tạo cảm xúc" },
        new() { Name = "Review trực diện", Hook = "3 điều cần biết trước khi mua...", SpeakingStyle = "Rõ ràng, súc tích", EditPacing = "Cắt nhanh, minh họa tính năng", AudioApproach = "Voice nổi bật, nhạc nền nhỏ" }];
    private string name = "Thử nghiệm phong cách mới";
    private string hypothesis = "Hook kể chuyện giúp tăng thời gian xem và lượt theo dõi.";
    private string topic = "";
    private string sourceText = "";
    private string sourceAnalysis = "";
    private string creatorPositioning = "";
    private string styleSummary = "";
    private string productContext = "";
    private string aiAnalysisSummary = "";
    private CreatorFlow.Web.Services.AiAnalyzeResponse? aiAnalysis;
    private bool aiGenerated;
    private int variantCount = 2;
    private bool busy;
    private string error = "";
    private Dictionary<Guid, MetricsInput> metricInputs = [];
    private Dictionary<Guid, string> winnerSelections = [];

    private static string StatusLabel(string status) => status switch
    {
        "Draft" => "Bản nháp",
        "Ready" => "Đã chuẩn bị",
        "Running" => "Đang thử nghiệm",
        "Published" => "Đã đăng",
        "Measured" => "Đã có số liệu",
        "Evaluated" => "Đã đánh giá",
        "Archived" => "Đã lưu trữ",
        _ => "Chưa xác định"
    };

    private MetricsInput GetMetrics(Guid id)
    {
        if (!metricInputs.TryGetValue(id, out var value)) metricInputs[id] = value = new MetricsInput();
        return value;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (!Api.IsConfigured) return;
        try
        {
            error = "";
            experiments = await Api.GetAsync<List<CreatorFlow.Web.Services.StyleExperimentItem>>("/api/v1/style-experiments?take=100") ?? [];
            foreach (var e in experiments)
            {
                if (!winnerSelections.ContainsKey(e.Id) && e.Variants.Length > 0) winnerSelections[e.Id] = e.Variants[0].Id.ToString();
                foreach (var v in e.Variants) GetMetrics(v.Id);
            }
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task AnalyzeWithAiAsync()
    {
        try
        {
            busy = true; error = ""; aiAnalysis = null; aiGenerated = false;
            aiAnalysis = await Api.PostAsync<CreatorFlow.Web.Services.AiAnalyzeRequest, CreatorFlow.Web.Services.AiAnalyzeResponse>(
                "/api/v1/ai/analyze", new(sourceText, "vi", string.IsNullOrWhiteSpace(topic) ? null : topic, creatorPositioning));
            if (aiAnalysis is null) throw new InvalidOperationException("AI không trả về kết quả phân tích.");
            sourceAnalysis = $"Tóm tắt: {aiAnalysis.Summary}\nChủ đề: {string.Join(", ", aiAnalysis.Topics)}\nÝ định khán giả: {aiAnalysis.AudienceIntent}\nCơ chế: {string.Join("; ", aiAnalysis.StoryMechanisms)}\nHook: {string.Join("; ", aiAnalysis.HookPatterns)}\nCơ hội Việt hóa: {string.Join("; ", aiAnalysis.LocalizationOpportunities)}";
            aiAnalysisSummary = aiAnalysis.Summary;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task GenerateWithAiAsync()
    {
        try
        {
            busy = true; error = ""; aiGenerated = false;
            var generated = await Api.PostAsync<CreatorFlow.Web.Services.AiGenerateVariantsRequest, CreatorFlow.Web.Services.AiGenerateVariantsResponse>(
                "/api/v1/ai/style-lab/generate-variants",
                new(sourceAnalysis, string.IsNullOrWhiteSpace(topic) ? "Chưa phân loại" : topic,
                    string.IsNullOrWhiteSpace(creatorPositioning) ? "Nhà sáng tạo nội dung Việt Nam" : creatorPositioning,
                    styleSummary, string.IsNullOrWhiteSpace(productContext) ? null : productContext, variantCount));
            if (generated is null || generated.Variants.Length != variantCount)
                throw new InvalidOperationException("AI không tạo đủ số phương án được yêu cầu.");
            variants = generated.Variants.Select(x => new VariantInput
            {
                Name = x.Name, Hook = x.Hook, SpeakingStyle = x.SpeakingStyle,
                EditPacing = x.EditPacing, AudioApproach = x.AudioApproach, Script = x.Script
            }).ToList();
            aiGenerated = true;
            if (string.IsNullOrWhiteSpace(name)) name = $"AI · {topic}";
            if (string.IsNullOrWhiteSpace(hypothesis)) hypothesis = "So sánh các góc sáng tạo khác nhau trên cùng một chủ đề.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task DownloadEditingPackageAsync(Guid experimentId, Guid variantId)
    {
        try
        {
            busy = true; error = "";
            var file = await Api.GetDownloadAsync($"/api/v1/style-experiments/{experimentId}/variants/{variantId}/editing-package");
            await JS.InvokeVoidAsync("creatorFlowDownload", file.FileName, file.ContentType, Convert.ToBase64String(file.Content));
        }
        catch (Exception ex) { error = $"Không thể tạo gói dựng: {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task StartAsync(Guid id) => await RunActionAsync($"/api/v1/style-experiments/{id}/start");
    private async Task MarkReadyAsync(Guid id, Guid variantId) => await RunActionAsync($"/api/v1/style-experiments/{id}/variants/{variantId}/ready");
    private async Task MarkPublishedAsync(Guid id, Guid variantId) => await RunActionAsync($"/api/v1/style-experiments/{id}/variants/{variantId}/publish");

    private async Task MeasureAsync(Guid id, Guid variantId)
    {
        var m = GetMetrics(variantId);
        await RunActionAsync($"/api/v1/style-experiments/{id}/variants/{variantId}/measure",
            new { views = m.Views, likes = m.Likes, comments = m.Comments, shares = m.Shares, saves = m.Saves,
                followsGained = m.FollowsGained, productClicks = m.ProductClicks, orders = m.Orders,
                averageWatchSeconds = m.AverageWatchSeconds, videoDurationSeconds = m.VideoDurationSeconds });
    }

    private async Task EvaluateAsync(Guid id)
    {
        if (Guid.TryParse(winnerSelections.GetValueOrDefault(id), out var winner))
            await RunActionAsync($"/api/v1/style-experiments/{id}/evaluate", new { winningVariantId = winner });
    }

    private async Task RunActionAsync(string path, object? payload = null)
    {
        try
        {
            busy = true; error = "";
            if (payload is null) await Api.PostNoContentAsync(path, new { });
            else await Api.PostNoContentAsync(path, payload);
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task CreateAsync()
    {
        try
        {
            busy = true; error = "";
            var payload = new
            {
                name, hypothesis, topic = string.IsNullOrWhiteSpace(topic) ? null : topic.Trim(), contentProjectId = (Guid?)null,
                variants = variants.Take(variantCount).Select(x => new { name = x.Name, hook = x.Hook,
                    speakingStyle = x.SpeakingStyle, editPacing = x.EditPacing, audioApproach = x.AudioApproach,
                    script = string.IsNullOrWhiteSpace(x.Script) ? $"Kịch bản tiếng Việt theo phong cách {x.Name}" : x.Script,
                    creativeNotes = (string?)null }).ToArray()
            };
            await Api.PostAsync<object, object>("/api/v1/style-experiments", payload);
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private sealed class MetricsInput
    {
        public long Views { get; set; }
        public long Likes { get; set; }
        public long Comments { get; set; }
        public long Shares { get; set; }
        public long Saves { get; set; }
        public long FollowsGained { get; set; }
        public long ProductClicks { get; set; }
        public long Orders { get; set; }
        public decimal? AverageWatchSeconds { get; set; }
        public decimal? VideoDurationSeconds { get; set; }
    }

    private sealed class VariantInput
    {
        public string Name { get; set; } = "";
        public string Hook { get; set; } = "";
        public string SpeakingStyle { get; set; } = "";
        public string EditPacing { get; set; } = "";
        public string AudioApproach { get; set; } = "";
        public string Script { get; set; } = "";
    }
}
