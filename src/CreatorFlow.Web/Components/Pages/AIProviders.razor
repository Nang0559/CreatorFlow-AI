@page "/settings/ai-providers"
@inject CreatorFlow.Web.Services.CreatorFlowApiClient Api
<PageTitle>Nhà cung cấp AI · CreatorFlow</PageTitle>
<header class="page-header">
    <div><p class="eyebrow">CẤU HÌNH TRÍ TUỆ NHÂN TẠO</p><h1>Nhà cung cấp AI</h1>
        <p class="muted">Quản lý Gemini, OpenAI hoặc máy chủ Ollama cho workspace hiện tại.</p></div>
    <button class="primary" @onclick="ReloadAsync" disabled="@busy">Làm mới</button>
</header>
@if (!string.IsNullOrWhiteSpace(message)) { <section class="notice"><strong>@message</strong></section> }
<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">DANH SÁCH NHÀ CUNG CẤP</p><h2>Thứ tự định tuyến</h2></div></div>
    @if (providers.Count == 0) { <p>Chưa có cấu hình trong workspace. Tạo Gemini làm Primary trước.</p> }
    @foreach (var item in providers)
    {
        <div class="variant-stats" style="padding:12px 0;border-bottom:1px solid var(--border,#ddd)">
            <div><strong>@item.DisplayName</strong><div class="muted">@item.Model · @item.BaseUrl</div>
                <small>@(item.RoutingRole == "Primary" ? "Primary" : $"Fallback #{item.FallbackOrder}") · @(item.IsActive ? "Đang bật" : "Đang tắt") · @(item.HasApiKey ? "Đã lưu API key" : "Chưa có API key")</small></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button @onclick="() => Edit(item)">Sửa</button>
                <button @onclick="() => TestAsync(item.Id)" disabled="@busy">Kiểm tra</button>
                <button @onclick="() => DeleteAsync(item.Id)" disabled="@busy">Xóa</button>
            </div>
        </div>
    }
</section>
<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">@(editingId is null ? "THÊM MỚI" : "CHỈNH SỬA")</p><h2>Cấu hình endpoint</h2></div></div>
    <div class="form-grid">
        <label>Tên hiển thị<input @bind="displayName" placeholder="Gemini chính" /></label>
        <label>Model<input @bind="model" placeholder="gemini-3.8-flash" /></label>
        <label>Base URL<input @bind="baseUrl" placeholder="https://generativelanguage.googleapis.com/v1beta/openai" /></label>
        <label>API key<input type="password" autocomplete="new-password" @bind="apiKey" placeholder="Để trống nếu giữ khóa đã lưu" /></label>
        <label>Vai trò<select @bind="routingRole"><option value="Primary">Primary</option><option value="Fallback">Fallback</option></select></label>
        <label>Thứ tự dự phòng<input type="number" min="1" max="20" @bind="fallbackOrder" disabled="@(routingRole == "Primary")" /></label>
        <label>Timeout (giây)<input type="number" min="5" max="300" @bind="timeoutSeconds" /></label>
        <label>Max output tokens<input type="number" min="256" max="16000" @bind="maxOutputTokens" /></label>
        <label><input type="checkbox" @bind="isActive" /> Kích hoạt nhà cung cấp</label>
    </div>
    <div style="display:flex;gap:10px;margin-top:16px">
        <button class="primary" @onclick="SaveAsync" disabled="@busy">Lưu cấu hình</button>
        <button @onclick="ResetForm">Hủy</button>
    </div>
    <p class="muted">Khóa chỉ được gửi tới API qua kết nối đã xác thực và lưu dưới dạng mã hóa phía máy chủ. Giao diện không đọc lại khóa. Khi sửa, để trống API key để giữ khóa hiện tại.</p>
</section>
@code {
    private List<ProviderItem> providers = [];
    private Guid? editingId;
    private string displayName = "Gemini";
    private string model = "gemini-3.8-flash";
    private string baseUrl = "https://generativelanguage.googleapis.com/v1beta/openai";
    private string apiKey = "";
    private string routingRole = "Primary";
    private int fallbackOrder = 1;
    private int timeoutSeconds = 120;
    private int maxOutputTokens = 3000;
    private bool isActive = true;
    private bool busy;
    private string message = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try { busy = true; providers = await Api.GetAsync<List<ProviderItem>>("/api/v1/ai/providers") ?? []; message = ""; }
        catch (HttpRequestException ex) { message = ex.Message; }
        catch { message = "Không thể tải cấu hình AI. Kiểm tra quyền Owner/Admin và kết nối API."; }
        finally { busy = false; }
    }

    private void Edit(ProviderItem item)
    {
        editingId = item.Id; displayName = item.DisplayName; model = item.Model; baseUrl = item.BaseUrl;
        apiKey = ""; routingRole = item.RoutingRole; fallbackOrder = item.FallbackOrder ?? 1;
        timeoutSeconds = item.TimeoutSeconds; maxOutputTokens = item.MaxOutputTokens; isActive = item.IsActive;
        message = "Đang sửa cấu hình. API key không được hiển thị; để trống để giữ khóa cũ.";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(displayName) || string.IsNullOrWhiteSpace(model) || string.IsNullOrWhiteSpace(baseUrl))
        { message = "Tên, model và Base URL là các trường bắt buộc."; return; }
        try
        {
            busy = true;
            var body = new ProviderWrite(displayName, baseUrl, model, string.IsNullOrWhiteSpace(apiKey) ? null : apiKey,
                isActive, routingRole, routingRole == "Primary" ? null : fallbackOrder, timeoutSeconds, maxOutputTokens);
            if (editingId is Guid id)
                await Api.PutAsync<ProviderWrite, ProviderItem>($"/api/v1/ai/providers/{id}", body);
            else
                await Api.PostAsync<ProviderWrite, ProviderItem>("/api/v1/ai/providers", body);
            ResetForm(); message = "Đã lưu cấu hình nhà cung cấp."; await ReloadAsync();
        }
        catch (Exception ex) { message = ex is HttpRequestException ? ex.Message : "Không thể lưu cấu hình. Kiểm tra dữ liệu và quyền workspace."; }
        finally { busy = false; }
    }

    private async Task TestAsync(Guid id)
    {
        try { busy = true; var result = await Api.PostAsync<object, TestResult>($"/api/v1/ai/providers/{id}/test", new { }); message = result?.Message ?? "Không nhận được kết quả kiểm tra."; }
        catch (Exception ex) { message = ex is HttpRequestException ? ex.Message : "Kiểm tra kết nối thất bại."; }
        finally { busy = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        try { busy = true; await Api.DeleteNoContentAsync($"/api/v1/ai/providers/{id}"); message = "Đã xóa nhà cung cấp."; await ReloadAsync(); }
        catch (Exception ex) { message = ex is HttpRequestException ? ex.Message : "Không thể xóa cấu hình."; }
        finally { busy = false; }
    }

    private void ResetForm()
    {
        editingId = null; displayName = "Gemini"; model = "gemini-3.8-flash";
        baseUrl = "https://generativelanguage.googleapis.com/v1beta/openai"; apiKey = "";
        routingRole = providers.Any(x => x.RoutingRole == "Primary" && x.IsActive) ? "Fallback" : "Primary";
        fallbackOrder = Math.Max(1, providers.Count(x => x.RoutingRole == "Fallback") + 1);
        timeoutSeconds = 120; maxOutputTokens = 3000; isActive = true;
    }

    private sealed record ProviderWrite(string DisplayName, string BaseUrl, string Model, string? ApiKey,
        bool IsActive, string RoutingRole, int? FallbackOrder, int TimeoutSeconds, int MaxOutputTokens);
    private sealed class ProviderItem
    {
        public Guid Id { get; set; } public string DisplayName { get; set; } = ""; public string BaseUrl { get; set; } = "";
        public string Model { get; set; } = ""; public bool IsActive { get; set; } public string RoutingRole { get; set; } = "";
        public int? FallbackOrder { get; set; } public int TimeoutSeconds { get; set; } public int MaxOutputTokens { get; set; }
        public bool HasApiKey { get; set; }
    }
    private sealed class TestResult { public bool Success { get; set; } public int? StatusCode { get; set; } public string Message { get; set; } = ""; }
}
