@page "/trends"
@using Microsoft.AspNetCore.Components
@inject CreatorFlow.Web.Services.CreatorFlowApiClient Api

<PageTitle>Xu hướng Việt Nam · CreatorFlow</PageTitle>
<header class="page-header">
    <div><p class="eyebrow">TRÍ TUỆ XU HƯỚNG VIỆT NAM</p><h1>Xu hướng Việt Nam</h1>
        <p class="muted">Theo dõi kênh, video và âm thanh; lưu lịch sử chỉ số để nhận biết xu hướng tăng tốc.</p></div>
    <button class="primary" disabled="@busy" @onclick="LoadAsync">@(busy ? "Đang xử lý…" : "Làm mới")</button>
</header>

@if (!Api.IsConfigured)
{
    <section class="notice"><strong>Chưa kết nối API</strong><p>Cấu hình CreatorFlowApi:BaseUrl và CreatorFlowApi:ApiKey ở server Web. API key không được gửi xuống trình duyệt.</p></section>
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <section class="notice validation-summary" role="alert"><strong>Chưa thực hiện được thao tác</strong><p>@error</p></section>
}
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <section class="success-notice" role="status" aria-live="polite"><strong>@successMessage</strong></section>
}
<section class="panel share-inbox-panel">
    <div class="panel-heading">
        <div><p class="eyebrow">HỘP THƯ LIÊN KẾT</p><h2>Nhận liên kết chia sẻ từ Douyin / TikTok</h2>
            <p class="muted">Trong Douyin, chọn Chia sẻ → Sao chép liên kết, quay lại đây và dán. Link được lưu riêng làm dữ liệu ưu tiên do bạn cung cấp; hệ thống chưa tự mở rộng link ngắn hoặc thay đổi điểm xếp hạng từ link này. AI vẫn có thể khám phá theo chủ đề mà không cần chia sẻ.</p>
        </div>
        <span class="status">@shareItems.Count liên kết</span>
    </div>
    <label>Liên kết vừa chia sẻ
        <textarea @bind="sharedUrl" rows="2" maxlength="1200" placeholder="Dán link Douyin / TikTok / YouTube / Facebook / Instagram tại đây"></textarea>
    </label>
    <div class="share-actions">
        <button class="primary" disabled="@(busy || !Api.IsConfigured || string.IsNullOrWhiteSpace(sharedUrl))" @onclick="SaveSharedLinkAsync">Nhận link chia sẻ</button>
        <button class="secondary" disabled="@busy" @onclick="LoadShareInboxAsync">Làm mới hộp thư</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(shareMessage)) { <p class="muted" role="status">@shareMessage</p> }
    @if (shareItems.Count == 0) { <p class="muted">Hộp thư đang trống.</p> }
    @foreach (var shared in shareItems)
    {
        <article class="share-item">
            <div><span class="status">@PlatformLabel(shared.Platform) · @ShareStatusLabel(shared.Status)</span>
                <p class="share-url">@shared.SharedUrl</p>
                <small class="muted">@shared.SharedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
            </div>
            <a href="@shared.SharedUrl" target="_blank" rel="noopener noreferrer">Mở liên kết ↗</a>
        </article>
    }
    <small class="muted">iPhone: bạn có thể dùng Shortcut “CreatorFlow – Nhận link” để chọn ngay trong bảng Chia sẻ; nếu chưa tạo Shortcut, hãy Sao chép liên kết rồi dán vào ô này. Hướng dẫn: docs/operations/IOS_SHARE_TO_CREATORFLOW.md.</small>
</section>

<section class="panel topic-management-panel">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">THIẾT LẬP KHÁM PHÁ</p>
            <h2>Quản lý chủ đề</h2>
            <p class="muted">Tạo các lĩnh vực bạn muốn theo dõi và nhập từ khóa để AI lập kế hoạch tìm kiếm. Chủ đề được lưu theo workspace của bạn.</p>
        </div>
        <span class="status">@topicItems.Count(x => x.IsActive) chủ đề đang dùng</span>
    </div>
    <div class="trend-form">
        <label>Tên chủ đề <span class="required-mark">* Tối đa 120 ký tự</span>
            <input @bind="topicName" maxlength="120" placeholder="Ví dụ: Đồ gia dụng thông minh" />
        </label>
        <label>Từ khóa tìm kiếm <span class="field-hint">Phân tách bằng dấu phẩy hoặc xuống dòng · mỗi từ khóa tối đa 100 ký tự</span>
            <textarea @bind="topicKeywords" rows="3" placeholder="máy hút bụi mini&#10;máy lau nhà&#10;đồ dùng nhà bếp"></textarea>
        </label>
    </div>
    <div class="form-actions">
        <button class="primary" disabled="@(busy || !Api.IsConfigured || string.IsNullOrWhiteSpace(topicName))" @onclick="SaveTopicAsync">@(busy ? "Đang lưu…" : editingTopicId.HasValue ? "Lưu thay đổi" : "Thêm chủ đề")</button>
        @if (editingTopicId.HasValue)
        {
            <button class="secondary" disabled="@busy" @onclick="CancelTopicEdit">Hủy chỉnh sửa</button>
        }
    </div>
    @if (topicItems.Count == 0)
    {
        <p class="muted">Chưa có chủ đề nào. Hãy tạo chủ đề đầu tiên ở trên để sử dụng chức năng tìm kênh theo chủ đề.</p>
    }
    else
    {
        <div class="topic-list">
            @foreach (var item in topicItems)
            {
                <article class="trend-item">
                    <div>
                        <span class="status">@(item.IsActive ? "Đang sử dụng" : "Đã ngừng")</span>
                        <h3>@item.Name</h3>
                        <p class="muted">@(string.IsNullOrWhiteSpace(item.Keywords) ? "Chưa khai báo từ khóa" : item.Keywords.Replace("\n", " · "))</p>
                    </div>
                    <div class="form-actions">
                        @if (item.IsActive)
                        {
                            <button class="secondary" disabled="@busy" @onclick="() => EditTopic(item)">Sửa</button>
                            <button class="secondary" disabled="@busy" @onclick="() => DeactivateTopicAsync(item)">Ngừng sử dụng</button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">KHÁM PHÁ CHỦ ĐỘNG</p><h2>Tìm kênh theo chủ đề bạn quan tâm</h2>
        <p class="muted">Chọn chủ đề đã lưu. CreatorFlow sẽ dùng AI tạo bộ truy vấn tìm kênh/video, gồm từ khóa sản phẩm và ý định mua hàng. Đây là kế hoạch tìm kiếm, chưa phải kết quả kênh đã được thu thập.</p></div></div>
    <div class="trend-form">
        <label>Chủ đề<select @bind="selectedTopicId">
            <option value="">-- Chọn chủ đề --</option>
            @foreach (var item in topicItems.Where(x => x.IsActive)) { <option value="@item.Id">@item.Name</option> }
        </select></label>
        <label>Sản phẩm / ngách muốn bán <span class="field-hint">Không bắt buộc</span><input @bind="discoveryProductContext" maxlength="1000" placeholder="Ví dụ: máy hút bụi mini, đồ gia dụng thông minh" /></label>
        <label>Khách hàng mục tiêu <span class="field-hint">Không bắt buộc</span><input @bind="discoveryAudienceContext" maxlength="1000" placeholder="Ví dụ: nữ 25–40 tuổi, gia đình trẻ" /></label>
    </div>
    <div class="form-actions"><button class="primary" disabled="@(busy || !Api.IsConfigured || string.IsNullOrWhiteSpace(selectedTopicId))" @onclick="DiscoverByTopicAsync">@(busy ? "Đang lập kế hoạch…" : "Tìm kênh theo chủ đề")</button>
        <span class="muted">Chọn một chủ đề đang sử dụng trong mục Quản lý chủ đề bên dưới. Không tự tạo số liệu bán hàng.</span></div>
    @if (discoveryPlan is not null)
    {
        <div class="discovery-plan">
            <h3>Bộ truy vấn đề xuất cho: @discoveryPlan.Topic</h3>
            <p class="muted">Thị trường: Việt Nam · Cần người duyệt: @((discoveryPlan.RequiresHumanReview) ? "Có" : "Không")</p>
            <strong>Từ khóa tìm kiếm</strong>
            <ul>@foreach (var query in discoveryPlan.Queries) { <li>@query</li> }</ul>
            @if (discoveryPlan.RelatedTopics.Length > 0) { <strong>Chủ đề liên quan</strong><p>@string.Join(" · ", discoveryPlan.RelatedTopics)</p> }
            @if (discoveryPlan.IntentSignals.Length > 0) { <strong>Tín hiệu ý định mua hàng</strong><p>@string.Join(" · ", discoveryPlan.IntentSignals)</p> }
            @if (discoveryPlan.Exclusions.Length > 0) { <strong>Loại trừ</strong><p>@string.Join(" · ", discoveryPlan.Exclusions)</p> }
            <p class="muted">Bước thu thập kết quả và xác minh hiệu suất thương mại chỉ hoạt động khi connector được cấp quyền và cấu hình. Không coi kế hoạch truy vấn là danh sách kênh đã tìm thấy.</p>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">GHI NHẬN</p><h2>Ghi nhận xu hướng mới</h2></div></div>
    <div class="trend-form">
        <label>Loại<select @bind="kind"><option>Video</option><option value="CreatorChannel">Kênh sáng tạo</option><option value="Sound">Âm thanh</option></select></label>
        <label>Nền tảng<select @bind="platform"><option value="TikTokVietnam">TikTok Việt Nam</option><option value="YouTubeShortsVietnam">YouTube Shorts Việt Nam</option><option value="FacebookReelsVietnam">Facebook Reels Việt Nam</option><option value="Other">Khác</option></select></label>
        <label>Mã nguồn <span class="required-mark">* Bắt buộc · tối đa 180 ký tự</span><input @bind="externalId" maxlength="180" required aria-required="true" placeholder="Mã video / mã kênh / mã âm thanh" /></label>
        <label>Tiêu đề <span class="required-mark">* Bắt buộc</span><input @bind="title" maxlength="300" required aria-required="true" placeholder="Tên video, kênh hoặc âm thanh" /></label>
        <label>Người sáng tạo <span class="field-hint">Không bắt buộc</span><input @bind="creator" /></label>
        <label>Đường dẫn HTTPS <span class="required-mark">* Bắt buộc</span><input @bind="sourceUrl" type="url" required aria-required="true" placeholder="https://..." /></label>
        <label>Chủ đề <span class="field-hint">Không bắt buộc</span><input @bind="topic" placeholder="Ví dụ: gia dụng, làm đẹp" /></label>
        <label>Tên nhạc <span class="field-hint">Không bắt buộc</span><input @bind="soundName" /></label>
        <label>Lượt xem<input type="number" min="0" @bind="views" /></label>
        <label>Lượt thích<input type="number" min="0" @bind="likes" /></label>
        <label>Bình luận<input type="number" min="0" @bind="comments" /></label>
        <label>Chia sẻ<input type="number" min="0" @bind="shares" /></label>
        <label>Lưu video<input type="number" min="0" @bind="saves" /></label>
    </div>
    <div class="form-actions"><button class="primary" disabled="@(!Api.IsConfigured || busy)" @onclick="CreateAsync">@(busy ? "Đang lưu…" : "Lưu quan sát")</button><span class="muted">* Trường bắt buộc. Các chỉ số mặc định là 0 nếu chưa có dữ liệu.</span></div>
</section>

<section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">THƯ VIỆN XU HƯỚNG</p><h2>Dữ liệu đã ghi nhận</h2></div><span class="status">@items.Count mục</span></div>
    @if (items.Count == 0) { <p class="muted">Chưa có dữ liệu xu hướng. Có thể thêm thủ công hoặc tích hợp connector sau.</p> }
    @foreach (var item in items)
    {
        <article class="trend-item">
            <div><span class="status">@KindLabel(item.Kind) · @PlatformLabel(item.Platform)</span><h3>@item.Title</h3><p class="muted">@item.CreatorName · @item.Topic</p><a href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">Mở nguồn ↗</a></div>
            <div class="trend-metrics"><strong>@item.Views.ToString("N0")</strong><small>Lượt xem</small><strong>@item.Likes.ToString("N0")</strong><small>Lượt thích</small><strong>@item.Shares.ToString("N0")</strong><small>Lượt chia sẻ</small><small>Ghi nhận @item.ObservedAt.ToLocalTime().ToString("dd/MM HH:mm")</small></div>
        </article>
    }
</section>

@code {
    private List<CreatorFlow.Web.Services.VietnamTrendItem> items = [];
    private string error = "";
    private string successMessage = "";
    private bool busy;
    private string kind = "Video", platform = "TikTokVietnam", externalId = "", title = "", creator = "", sourceUrl = "", topic = "", soundName = "";
    private long views, likes, comments, shares, saves;
    private string sharedUrl = "";
    private string shareMessage = "";
    private List<SharedLinkItem> shareItems = [];
    private List<TopicItem> topicItems = [];
    private string selectedTopicId = "", discoveryProductContext = "", discoveryAudienceContext = "";
    private string topicName = "", topicKeywords = "";
    private Guid? editingTopicId;
    private DiscoveryPlanItem? discoveryPlan;

    [Parameter, SupplyParameterFromQuery(Name = "sharedUrl")] public string? IncomingSharedUrl { get; set; }
    private string? lastAutoSubmittedLink;

    protected override async Task OnInitializedAsync() { await LoadAsync(); await LoadShareInboxAsync(); await LoadTopicsAsync(); }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(IncomingSharedUrl) && IncomingSharedUrl != lastAutoSubmittedLink)
        {
            lastAutoSubmittedLink = IncomingSharedUrl;
            sharedUrl = IncomingSharedUrl;
            await SaveSharedLinkAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (!Api.IsConfigured || busy) return;
        try
        {
            busy = true; error = ""; successMessage = "";
            items = await Api.GetAsync<List<CreatorFlow.Web.Services.VietnamTrendItem>>("/api/v1/vietnam-trends?take=100") ?? [];
            successMessage = "Đã tải " + items.Count + " mục xu hướng.";
        }
        catch (Exception ex) { error = ToUserMessage(ex); }
        finally { busy = false; }
    }


    private async Task LoadTopicsAsync()
    {
        if (!Api.IsConfigured) return;
        try { topicItems = await Api.GetAsync<List<TopicItem>>("/api/v1/topics?take=100") ?? []; }
        catch (Exception ex) { error = "Không tải được danh sách chủ đề: " + ex.Message; }
    }

    private void EditTopic(TopicItem item)
    {
        editingTopicId = item.Id;
        topicName = item.Name;
        topicKeywords = item.Keywords;
        error = "";
        successMessage = "";
    }

    private void CancelTopicEdit()
    {
        editingTopicId = null;
        topicName = topicKeywords = "";
    }

    private async Task SaveTopicAsync()
    {
        if (string.IsNullOrWhiteSpace(topicName))
        {
            error = "Vui lòng nhập tên chủ đề.";
            return;
        }
        if (topicName.Trim().Length > 120)
        {
            error = "Tên chủ đề không được vượt quá 120 ký tự.";
            return;
        }

        try
        {
            busy = true;
            error = "";
            successMessage = "";
            var request = new { name = topicName.Trim(), keywords = topicKeywords };
            if (editingTopicId.HasValue)
                await Api.PutNoContentAsync($"/api/v1/topics/{editingTopicId.Value}", request);
            else
                await Api.PostAsync<object, TopicItem>("/api/v1/topics", request);

            var wasEditing = editingTopicId.HasValue;
            CancelTopicEdit();
            await LoadTopicsAsync();
            successMessage = wasEditing ? "Đã cập nhật chủ đề." : "Đã tạo chủ đề. Bạn có thể chọn chủ đề này để tìm kênh.";
        }
        catch (Exception ex) { error = ToUserMessage(ex); }
        finally { busy = false; }
    }

    private async Task DeactivateTopicAsync(TopicItem item)
    {
        try
        {
            busy = true;
            error = "";
            successMessage = "";
            await Api.PostAsync<object, object>($"/api/v1/topics/{item.Id}/deactivate", new { });
            if (selectedTopicId == item.Id.ToString()) selectedTopicId = "";
            if (editingTopicId == item.Id) CancelTopicEdit();
            await LoadTopicsAsync();
            successMessage = $"Đã ngừng sử dụng chủ đề \"{item.Name}\". Dữ liệu lịch sử không bị xóa.";
        }
        catch (Exception ex) { error = ToUserMessage(ex); }
        finally { busy = false; }
    }

    private async Task DiscoverByTopicAsync()
    {
        if (!Guid.TryParse(selectedTopicId, out var topicId)) { error = "Vui lòng chọn chủ đề."; return; }
        try
        {
            busy = true; error = ""; successMessage = ""; discoveryPlan = null;
            discoveryPlan = await Api.PostAsync<object, DiscoveryPlanItem>($"/api/v1/topics/{topicId}/discovery-plan",
                new { productContext = discoveryProductContext, audienceContext = discoveryAudienceContext, maxQueries = 8 });
            if (discoveryPlan is null) error = "AI chưa trả về kế hoạch tìm kiếm.";
            else successMessage = "Đã tạo bộ truy vấn khám phá cho chủ đề.";
        }
        catch (Exception ex) { error = ToUserMessage(ex); }
        finally { busy = false; }
    }

    private async Task LoadShareInboxAsync()
    {
        if (!Api.IsConfigured) return;
        try { shareItems = await Api.GetAsync<List<SharedLinkItem>>("/api/v1/share-inbox?take=30") ?? []; }
        catch (Exception ex) { shareMessage = $"Không tải được hộp thư chia sẻ: {ex.Message}"; }
    }

    private async Task SaveSharedLinkAsync()
    {
        try
        {
            busy = true; shareMessage = "";
            var saved = await Api.PostAsync<object, SharedLinkItem>("/api/v1/share-inbox", new { sharedUrl = sharedUrl.Trim() });
            if (saved is not null)
            {
                shareMessage = "Đã nhận và lưu link. Hiện chưa tự mở rộng hoặc chấm điểm link; không tự follow hay tương tác trên Douyin.";
                sharedUrl = "";
                await LoadShareInboxAsync();
            }
        }
        catch (Exception ex) { shareMessage = ex.Message; }
        finally { busy = false; }
    }

    private static string KindLabel(string value) => value switch { "Video" => "Video", "CreatorChannel" => "Kênh sáng tạo", "Sound" => "Âm thanh", _ => "Khác" };
    private static string PlatformLabel(string value) => value switch { "TikTokVietnam" => "TikTok Việt Nam", "YouTubeShortsVietnam" => "YouTube Shorts Việt Nam", "FacebookReelsVietnam" => "Facebook Reels Việt Nam", "Douyin" => "Douyin", _ => "Khác" };
    private static string ShareStatusLabel(string value) => value switch { "Pending" => "Chờ xem xét", "Reviewed" => "Đã xem xét", "Linked" => "Đã liên kết", "Ignored" => "Đã bỏ qua", _ => "Chưa xác định" };

    private sealed record TopicItem(Guid Id, string Name, string Keywords, bool IsActive, DateTimeOffset CreatedAt, DateTimeOffset UpdatedAt);
    private sealed record DiscoveryPlanItem(string Topic, string[] Queries, string[] RelatedTopics, string[] IntentSignals, string[] Exclusions, bool RequiresHumanReview);

    private sealed record SharedLinkItem(Guid Id, string Platform, string SharedUrl,
        DateTimeOffset SharedAt, string Status, string? ReviewNote, Guid? LinkedChannelId);

    private async Task CreateAsync()
    {
        try
        {
            busy = true; error = ""; successMessage = "";
            var validation = ValidateTrendForm();
            if (validation is not null) { error = validation; return; }
            var request = new { kind, platform, externalId = externalId.Trim(), title = title.Trim(), creatorName = creator, sourceUrl = sourceUrl.Trim(), topic,
                soundName = string.IsNullOrWhiteSpace(soundName) ? null : soundName, soundArtist = (string?)null,
                views, likes, comments, shares, saves, publishedAt = (DateTimeOffset?)null };
            await Api.PostAsync<object, object>("/api/v1/vietnam-trends", request);
            successMessage = "Đã lưu ghi nhận xu hướng thành công.";
            externalId = title = creator = sourceUrl = topic = soundName = "";
            views = likes = comments = shares = saves = 0;
            items = await Api.GetAsync<List<CreatorFlow.Web.Services.VietnamTrendItem>>("/api/v1/vietnam-trends?take=100") ?? [];
        }
        catch (Exception ex) { error = ToUserMessage(ex); }
        finally { busy = false; }
    }

    private string? ValidateTrendForm()
    {
        if (string.IsNullOrWhiteSpace(externalId)) return "Vui lòng nhập Mã nguồn.";
        if (externalId.Trim().Length > 180) return "Mã nguồn không được vượt quá 180 ký tự.";
        if (string.IsNullOrWhiteSpace(title)) return "Vui lòng nhập Tiêu đề.";
        if (string.IsNullOrWhiteSpace(sourceUrl)) return "Vui lòng nhập Đường dẫn HTTPS.";
        if (!Uri.TryCreate(sourceUrl.Trim(), UriKind.Absolute, out var uri) || uri.Scheme != Uri.UriSchemeHttps)
            return "Đường dẫn nguồn phải là URL hợp lệ bắt đầu bằng https://.";
        if (new[] { views, likes, comments, shares, saves }.Any(x => x < 0))
            return "Các chỉ số không được là số âm.";
        return null;
    }

    private static string ToUserMessage(Exception ex)
    {
        var message = ex.Message;
        if (message.Contains("ExternalIdentifier", StringComparison.OrdinalIgnoreCase) ||
            message.Contains("ExternalId", StringComparison.OrdinalIgnoreCase))
            return "Mã nguồn là trường bắt buộc và không được vượt quá 180 ký tự.";
        if (message.Contains("HTTP 409", StringComparison.OrdinalIgnoreCase))
            return "Ghi nhận này đã tồn tại. Hãy dùng chức năng cập nhật quan sát thay vì tạo mục trùng.";
        if (message.Contains("HTTP 400", StringComparison.OrdinalIgnoreCase))
            return "Dữ liệu chưa hợp lệ. Hãy kiểm tra các trường có dấu * và định dạng đường dẫn HTTPS.";
        return "Không thể hoàn tất yêu cầu. Chi tiết: " + message;
    }
}
