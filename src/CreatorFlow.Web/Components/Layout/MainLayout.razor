@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar desktop-sidebar">
        <a class="brand" href="/" aria-label="CreatorFlow AI – Tổng quan">CreatorFlow <span>AI</span></a>
        <p class="nav-caption">WORKSPACE</p>
        <nav class="primary-nav" aria-label="Điều hướng chính">
            <NavLink href="/" Match="NavLinkMatch.All">Tổng quan</NavLink>
            <NavLink href="/trends">Khám phá</NavLink>
            <NavLink href="/style-lab">Studio</NavLink>
            <NavLink href="/analytics">Hiệu quả</NavLink>
            <NavLink href="/settings">Thiết lập</NavLink>
        </nav>
        <div class="sidebar-secondary">
            <p class="nav-caption">QUẢN LÝ</p>
            <NavLink href="/projects">Dự án nội dung</NavLink>
            <NavLink href="/style-profiles">Phong cách riêng</NavLink>
            <NavLink href="/assets">Thư viện media</NavLink>
        </div>
        <div class="sidebar-note"><span class="privacy-dot"></span> Duyệt thủ công trước khi xuất bản</div>
    </aside>

    <header class="mobile-topbar">
        <a class="brand" href="/">CreatorFlow <span>AI</span></a>
        <a class="mobile-settings" href="/settings" aria-label="Thiết lập">⚙</a>
    </header>

    <main class="main-content">
