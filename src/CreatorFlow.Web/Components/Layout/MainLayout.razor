    <nav class="mobile-bottom-nav" aria-label="Điều hướng chính trên điện thoại">
        <NavLink href="/" Match="NavLinkMatch.All" aria-label="Tổng quan"><span class="mobile-nav-icon">⌂</span><span>Tổng quan</span></NavLink>
        <NavLink href="/trends" aria-label="Khám phá"><span class="mobile-nav-icon">⌕</span><span>Khám phá</span></NavLink>
        <NavLink href="/style-lab" aria-label="Studio"><span class="mobile-nav-icon">✳</span><span>Studio</span></NavLink>
        <NavLink href="/analytics" aria-label="Hiệu quả"><span class="mobile-nav-icon">▥</span><span>Hiệu quả</span></NavLink>
        <NavLink href="/settings" aria-label="Thiết lập"><span class="mobile-nav-icon">⚙</span><span>Thiết lập</span></NavLink>
    </nav>
</div>
