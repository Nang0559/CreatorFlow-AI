+
+        var put = await client.PutAsJsonAsync(Route, new[]
+        {
+            Provider(headersJson: $"{{\"X-Client-Token\":\"{headerSecret}\"}}", apiKey: apiKey, apiKeyHeader: "X-API-Key")
