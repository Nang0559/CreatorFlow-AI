diff --git a/tests/CreatorFlow.Api.Tests/TikTokLinkFollowEndpointTests.cs b/tests/CreatorFlow.Api.Tests/TikTokLinkFollowEndpointTests.cs
new file mode 100644
index 0000000..1de0069
