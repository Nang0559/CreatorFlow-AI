+++ b/tests/CreatorFlow.Api.Tests/TikTokLinkFollowEndpointTests.cs
@@ -0,0 +1,153 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text;
+using System.Text.Json;
+using CreatorFlow.Api.Discovery;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.Extensions.DependencyInjection;
+using Xunit;
+
+namespace CreatorFlow.Api.Tests;
+
+/// <summary>
+/// Endpoint tests for "follow a channel from a shared TikTok link". oEmbed is replaced by a stub
+/// handler, so no outbound network call is made. They run on EF InMemory (no SQL Server parity).
+/// </summary>
+public sealed class TikTokLinkFollowEndpointTests
+{
+    private const string Route = "/api/v1/douyin/channels/from-link";
+    private const string FullLink = "https://www.tiktok.com/@creator.vn/video/7300000000000000001";
+
+    private sealed class StubHandler(HttpStatusCode status, string body) : HttpMessageHandler
+    {
+        public List<Uri> Requests { get; } = [];
+
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Requests.Add(request.RequestUri!);
+            return Task.FromResult(new HttpResponseMessage(status)
+            {
+                Content = new StringContent(body, Encoding.UTF8, "application/json")
+            });
+        }
+    }
+
+    private const string OEmbedJson = """
+        {"title":"Mẹo quay video","author_name":"Creator VN","author_url":"https://www.tiktok.com/@creator.vn","embed_product_id":"7300000000000000001"}
+        """;
+
+    private static (HttpClient Client, IDisposable Owner) CreateClient(StubHandler handler)
+    {
+        var factory = new CreatorFlowApiFactory();
+        var custom = factory.WithWebHostBuilder(builder => builder.ConfigureServices(services =>
+            services.AddHttpClient(TikTokLinkFollowEndpoints.HttpClientName)
+                .ConfigurePrimaryHttpMessageHandler(() => handler)));
+        var client = custom.CreateClient();
+        client.DefaultRequestHeaders.Add("X-CreatorFlow-Api-Key", CreatorFlowApiFactory.ApiKey);
+        return (client, new Disposables(client, custom, factory));
+    }
+
+    private sealed class Disposables(params IDisposable[] items) : IDisposable
+    {
+        public void Dispose() { foreach (var item in items) item.Dispose(); }
+    }
+
+    [Fact]
+    public async Task Follows_channel_records_video_and_only_calls_the_fixed_oembed_host()
+    {
+        var handler = new StubHandler(HttpStatusCode.OK, OEmbedJson);
+        var (client, owner) = CreateClient(handler);
+        using var _ = owner;
+
+        var response = await client.PostAsJsonAsync(Route, new { url = FullLink });
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal("creator.vn", body.GetProperty("handle").GetString());
+        Assert.Equal("Creator VN", body.GetProperty("displayName").GetString());
+        Assert.True(body.GetProperty("channelCreated").GetBoolean());
+        Assert.True(body.GetProperty("followed").GetBoolean());
+        Assert.True(body.GetProperty("videoRecorded").GetBoolean());
+        Assert.Equal("oembed", body.GetProperty("metadataSource").GetString());
+
+        var request = Assert.Single(handler.Requests);
+        Assert.Equal("www.tiktok.com", request.Host);
+        Assert.Equal("/oembed", request.AbsolutePath);
+
+        var channelId = body.GetProperty("channelId").GetGuid();
+        var videos = await client.GetFromJsonAsync<JsonElement>($"/api/v1/douyin/channels/{channelId}/videos");
+        Assert.Equal(1, videos.GetArrayLength());
+        Assert.Equal("FollowedChannel", videos[0].GetProperty("discoveryMethod").GetString());
+
+        var activity = await client.GetFromJsonAsync<JsonElement>("/api/v1/douyin/channels/activity");
+        Assert.Equal(1, activity.GetArrayLength());
+        Assert.Equal(1, activity[0].GetProperty("newVideoCount").GetInt32());
+    }
+
+    [Fact]
+    public async Task Sharing_the_same_video_again_does_not_duplicate_channel_or_video()
+    {
+        var (client, owner) = CreateClient(new StubHandler(HttpStatusCode.OK, OEmbedJson));
+        using var _ = owner;
+
+        await client.PostAsJsonAsync(Route, new { url = FullLink });
+        var second = await client.PostAsJsonAsync(Route, new { url = FullLink });
+        Assert.Equal(HttpStatusCode.OK, second.StatusCode);
+        var body = await second.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.False(body.GetProperty("channelCreated").GetBoolean());
+        Assert.False(body.GetProperty("videoRecorded").GetBoolean());
+        Assert.True(body.GetProperty("videoAlreadyKnown").GetBoolean());
+
+        var channels = await client.GetFromJsonAsync<JsonElement>("/api/v1/douyin/channels?take=100");
+        Assert.Equal(1, channels.GetArrayLength());
+    }
+
+    [Fact]
+    public async Task Full_link_still_works_when_oembed_is_unavailable()
+    {
+        var (client, owner) = CreateClient(new StubHandler(HttpStatusCode.InternalServerError, "{}"));
+        using var _ = owner;
+
+        var response = await client.PostAsJsonAsync(Route, new { url = FullLink });
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal("@creator.vn", body.GetProperty("displayName").GetString());
+        Assert.Equal("link", body.GetProperty("metadataSource").GetString());
+        Assert.True(body.GetProperty("videoRecorded").GetBoolean());
+    }
+
+    [Fact]
+    public async Task Short_link_needs_oembed_to_identify_the_channel()
+    {
+        const string shortLink = "https://vm.tiktok.com/ZMabc123/";
+
+        var (okClient, okOwner) = CreateClient(new StubHandler(HttpStatusCode.OK, OEmbedJson));
+        using (okOwner)
+        {
+            var ok = await okClient.PostAsJsonAsync(Route, new { url = shortLink });
+            Assert.Equal(HttpStatusCode.OK, ok.StatusCode);
+        }
+
+        var (failClient, failOwner) = CreateClient(new StubHandler(HttpStatusCode.NotFound, "{}"));
+        using (failOwner)
+        {
+            var failed = await failClient.PostAsJsonAsync(Route, new { url = shortLink });
+            Assert.Equal(HttpStatusCode.BadRequest, failed.StatusCode);
+        }
+    }
+
+    [Theory]
+    [InlineData("https://www.youtube.com/watch?v=abc123")]
+    [InlineData("http://www.tiktok.com/@creator/video/7300000000000000001")]
+    [InlineData("https://evil.example/@creator/video/7300000000000000001")]
+    [InlineData("")]
+    public async Task Rejects_non_tiktok_or_unsafe_links_without_calling_oembed(string url)
+    {
+        var handler = new StubHandler(HttpStatusCode.OK, OEmbedJson);
+        var (client, owner) = CreateClient(handler);
+        using var _ = owner;
+
+        var response = await client.PostAsJsonAsync(Route, new { url });
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Empty(handler.Requests);
+    }
+}
