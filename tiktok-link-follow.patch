+    [InlineData("")]
+    [InlineData("   ")]
+    [InlineData("http://www.tiktok.com/@creator/video/7300000000000001")]      // not HTTPS
+    [InlineData("https://www.tiktok.com:8443/@creator/video/7300000000000001")] // non-standard port
+    [InlineData("https://user:pass@www.tiktok.com/@creator")]                   // embedded credentials
+    [InlineData("https://evil.example/@creator/video/7300000000000001")]        // other host
+    [InlineData("https://tiktok.com.evil.example/@creator")]                    // look-alike host
+    [InlineData("https://www.youtube.com/watch?v=abc123")]
+    [InlineData("javascript:alert(1)")]
+    public void TryParse_rejects_unsafe_or_unsupported_links(string raw)
+    {
+        Assert.False(TikTokLink.TryParse(raw, out var uri, out var error));
+        Assert.Null(uri);
+        Assert.False(string.IsNullOrWhiteSpace(error));
+    }
+
+    [Fact]
+    public void TryParse_keeps_path_and_query_and_drops_fragment()
+    {
+        Assert.True(TikTokLink.TryParse(
+            "  https://www.tiktok.com/@user.name_1/video/7300000000000000001?is_from_webapp=1#top ", out var uri, out _));
+        Assert.Equal("https://www.tiktok.com/@user.name_1/video/7300000000000000001?is_from_webapp=1", uri!.ToString());
+        Assert.Equal("user.name_1", TikTokLink.ExtractHandle(uri));
+        Assert.Equal("7300000000000000001", TikTokLink.ExtractVideoId(uri));
+    }
+
+    [Fact]
+    public void Profile_and_short_links_have_no_video_id()
+    {
+        Assert.True(TikTokLink.TryParse("https://www.tiktok.com/@creator", out var profile, out _));
+        Assert.Equal("creator", TikTokLink.ExtractHandle(profile!));
+        Assert.Null(TikTokLink.ExtractVideoId(profile!));
+
+        Assert.True(TikTokLink.TryParse("https://vm.tiktok.com/ZMabc123/", out var shortLink, out _));
+        Assert.Null(TikTokLink.ExtractHandle(shortLink!));
+        Assert.Null(TikTokLink.ExtractVideoId(shortLink!));
+    }
+
+    [Fact]
+    public void BuildOEmbedUri_always_targets_the_fixed_tiktok_host()
+    {
+        Assert.True(TikTokLink.TryParse("https://www.tiktok.com/@creator/video/7300000000000001?a=b&c=d", out var uri, out _));
+        var oembed = TikTokLink.BuildOEmbedUri(uri!);
+        Assert.Equal("www.tiktok.com", oembed.Host);
+        Assert.Equal("/oembed", oembed.AbsolutePath);
+        Assert.Contains("https%3A%2F%2Fwww.tiktok.com%2F%40creator%2Fvideo%2F7300000000000001", oembed.Query);
+    }
+
+    [Fact]
+    public void ParseOEmbed_reads_title_author_handle_and_video_id()
+    {
+        const string json = """
+            {"version":"1.0","type":"video","title":"  Mẹo quay video  ","author_name":"Creator VN",
+             "author_url":"https://www.tiktok.com/@creator.vn","embed_product_id":"7300000000000000001"}
+            """;
+        var info = TikTokLink.ParseOEmbed(json);
+        Assert.NotNull(info);
+        Assert.Equal("Mẹo quay video", info!.Title);
+        Assert.Equal("Creator VN", info.AuthorName);
+        Assert.Equal("creator.vn", info.Handle);
+        Assert.Equal("7300000000000000001", info.VideoId);
+    }
+
+    [Fact]
+    public void ParseOEmbed_falls_back_to_html_video_id_and_ignores_bad_input()
+    {
+        const string json = """{"author_unique_id":"creator","html":"<blockquote data-video-id=\"7300000000000000002\"></blockquote>"}""";
+        var info = TikTokLink.ParseOEmbed(json);
+        Assert.Equal("creator", info!.Handle);
+        Assert.Equal("7300000000000000002", info.VideoId);
+
+        Assert.Null(TikTokLink.ParseOEmbed("not json"));
+        Assert.Null(TikTokLink.ParseOEmbed("[]"));
+        Assert.Null(TikTokLink.ParseOEmbed(null));
+    }
+}
